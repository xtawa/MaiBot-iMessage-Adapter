{
  "manifest_version": 2,
  "id": "com.galeros.imessage_adapter",
  "version": "0.1.12",
  "name": "iMessage 连接器 / iMessage Adapter",
  "description": "将你的MaiBot通过Photon连接到iMessage，允许通过iMessage发送和接收消息。",
  "author": {
    "name": "mayan613",
    "url": "https://github.com/mayan613"
  },
  "license": "GPL-3.0",
  "urls": {
    "repository": "https://github.com/xtawa/MaiBot-iMessage-Adapter",
    "homepage": "https://github.com/xtawa/MaiBot-iMessage-Adapter",
    "documentation": "https://www.galeros.xyz/2026/07/07/imessage-adapter",
    "issues": "https://github.com/xtawa/MaiBot-iMessage-Adapter/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.1.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "nodeenv",
      "version_spec": ">=1.10.0"
    },
    {
      "type": "python_package",
      "name": "websockets",
      "version_spec": ">=16.0"
    }
  ],
  "plugin_type": "adapter",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "wrench"
    }
  },
  "capabilities": [
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN",
      "en-US",
      "ja_JP",
      "ko_KR"
    ]
  }
}
